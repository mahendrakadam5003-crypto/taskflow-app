# Copy this file to .env and set your deployment-specific values.
# Never commit .env or live credentials.

# Set to 1 only for an explicitly local SQLite development database.
USE_LOCAL_DB=0
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-rotated-database-token
TURSO_PLATFORM_TOKEN=replace-with-rotated-platform-token
TURSO_ORG=your-organization
TURSO_DATABASE=your-database

# Optional control-plane override. Leave unset to store super-admin and control metadata
# alongside company data in TURSO_DATABASE_URL using TURSO_AUTH_TOKEN.
# CONTROL_DATABASE_URL=libsql://your-control-database.turso.io
# CONTROL_AUTH_TOKEN=replace-with-control-database-token
# Generate a random 32-byte key; keep the same key available for decrypting tenant tokens.
APP_ENCRYPTION_KEY=replace-with-64-hex-characters
# Optional label for the existing Turso-backed company listed in the super-admin overview.
LEGACY_COMPANY_NAME=Existing Company
LEGACY_COMPANY_CODE=existing-company
# Used only for the one-time initial account command; never commit real values.
SUPERADMIN_NAME=
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=

TELEGRAM_BOT_TOKEN=replace-with-rotated-bot-token
TELEGRAM_CHANNEL_ID=your-channel-id
# Optional automatic backups require a separate private channel where this bot is an administrator.
AUTO_DAILY_BACKUPS=false
TELEGRAM_BACKUP_CHANNEL_ID=your-private-backup-channel-id
# Private one-to-one Telegram chat ID for backup failure alerts.
TELEGRAM_BACKUP_ALERT_CHAT_ID=your-private-chat-id
# Optional archive part size in bytes (maximum 19922944 for Telegram downloads).
BACKUP_PART_BYTES=18874368

SESSION_SECRET=generate-a-long-random-secret
# Optional. If unset, the first startup generates a random password and prints it once.
INITIAL_ADMIN_PASSWORD=
PORT=3000

# Public origin used in employee and administrator invitation links.
# Use only the origin (scheme + host + optional port), with no path or trailing slash.
APP_BASE_URL=
# Required for employee invitations, email verification, and email OTP sign-in.
# Use implicit TLS on port 465 or STARTTLS on other ports.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional Google OAuth web client. Register GOOGLE_REDIRECT_URI exactly with Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
