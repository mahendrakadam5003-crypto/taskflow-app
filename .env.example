# Copy this file to .env and set your deployment-specific values.
# Never commit .env or live credentials.

TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-rotated-database-token
TURSO_PLATFORM_TOKEN=replace-with-rotated-platform-token
TURSO_ORG=your-organization
TURSO_DATABASE=your-database

TELEGRAM_BOT_TOKEN=replace-with-rotated-bot-token
TELEGRAM_CHANNEL_ID=your-channel-id

SESSION_SECRET=generate-a-long-random-secret
# Optional. If unset, the first startup generates a random password and prints it once.
INITIAL_ADMIN_PASSWORD=
PORT=3000
