{
  "name": "taskflow-app",
  "version": "1.0.0",
  "description": "Self-hosted internal task manager + employee attendance (punch in/out, on-site detection)",
  "main": "server.js",
  "engines": {
    "node": "20.18.0"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "build:native-bridge": "esbuild scripts/native-capacitor-entry.js --bundle --platform=browser --format=iife --target=es2020 --outfile=public/js/native-capacitor.js",
    "postinstall": "npm run build:native-bridge",
    "android:debug": "npx cap sync android && cd android && gradlew assembleDebug",
    "migrate:control": "node scripts/migrate-control-db.js",
    "migrate:all": "node scripts/migrate-all-tenants.js",
    "superadmin:create": "node scripts/create-superadmin.js",
    "company:register-existing": "node scripts/register-legacy-company.js"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^9.1.2",
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.0",
    "@capacitor/camera": "^7.0.1",
    "@capacitor/core": "^7.6.9",
    "@capacitor/geolocation": "^7.1.5",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/ios": "^7.6.9",
    "@capacitor/local-notifications": "^7.0.2",
    "@libsql/client": "^0.3.5",
    "@libsql/sqlite3": "^0.3.1",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.6.0",
    "esbuild": "^0.28.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.18.0",
    "file-type": "^21.3.4",
    "form-data": "^4.0.1",
    "helmet": "^8.3.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.15",
    "session-file-store": "^1.5.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "typescript": "^7.0.2"
  }
}
